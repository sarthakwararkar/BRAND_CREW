# Local Ollama models are used by default; no model API key is required.
GEMINI_API_KEY=

# Start Ollama and make sure these models are installed:
#   ollama pull qwen2.5:3b
#   ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434

# MongoDB must be running locally, or point this to your MongoDB connection string.
MONGODB_URI=mongodb://localhost:27017/brandcrew

# Optional: override model defaults.
# FAST_MODEL=ollama_chat/qwen2.5:3b
# STRONG_MODEL=ollama_chat/qwen2.5:3b
# CODE_MODEL=ollama_chat/qwen2.5:3b
# Set VISION_MODEL to an installed vision-capable Ollama model to analyze images.
# VISION_MODEL=ollama_chat/<vision-model>
# EMBEDDER_PROVIDER=ollama
# EMBEDDER_MODEL=nomic-embed-text:latest
# Optional remote model and embedding providers:
# EMBEDDER_PROVIDER=openai
# EMBEDDER_MODEL=text-embedding-3-small
# OPENAI_API_KEY=
SEARCH_API_KEY=

# Required only if you plan to use the protected brand-reseed endpoint.
ADMIN_TOKEN=
